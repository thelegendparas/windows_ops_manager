# =====================================================================
# Copy this file to ".env" and fill in. The agent itself can NEVER read
# .env — the filesystem security policy blocks it (that's the point).
# =====================================================================

# ---- model (get a key at https://openrouter.ai/keys) ----
OPENROUTER_API_KEY=sk-or-...
MODEL_NAME=z-ai/glm-4.6

# ---- agent scope ----
# The app/repo this agent operates on. Git tools and relative log paths
# resolve against this. "." means "wherever the agent was started".
APP_DIR=.
AUDIT_DIR=logs
CONFIRM_TTL_SECONDS=300

# ---- security: tier 2 allowlists (comma separated, empty = nothing allowed) ----
# Windows services the agent may start/stop/restart (short names — check
# with `sc query` or ask the agent: "list services"). E.g.:
# ALLOWED_SERVICES=MyDiscordBot,postgresql-x64-16
ALLOWED_SERVICES=

# Process names the agent may kill, e.g.:
# ALLOWED_KILL_NAMES=python.exe,bot.exe
ALLOWED_KILL_NAMES=

# ---- security: file access ----
# If set, file tools may only read under these roots (comma separated).
# Empty = anywhere except the built-in blocklist (.env, keys, .ssh, .aws, .gnupg, .git).
ALLOWED_ROOTS=
# Extra forbidden filename globs on top of the defaults (comma separated)
FORBIDDEN_GLOBS=
FORBIDDEN_PATH_PARTS=